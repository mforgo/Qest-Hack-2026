# Copy to `.env` and fill in. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# IBM Quantum (used by examples/ibm_qpu.py, qiskit-ibm-runtime)
# ---------------------------------------------------------------------------
# 44-character IBM Cloud API key (NOT a bearer token).
QISKIT_IBM_TOKEN=
# Optional but recommended: service CRN (instance). Auto-selected if empty.
QISKIT_IBM_INSTANCE=
# Channel: ibm_quantum_platform (default) | ibm_cloud (legacy) | local
QISKIT_IBM_CHANNEL=ibm_quantum_platform

# ---------------------------------------------------------------------------
# IQM Resonance (used by examples/iqm_qpu.py, iqm-client)
# ---------------------------------------------------------------------------
# Base server URL only - do NOT append the quantum computer name or a timeslot.
IQM_SERVER_URL=https://resonance.iqm.tech/
# Token generated in the Resonance dashboard.
IQM_TOKEN=
# Quantum computer name. Use a real QPU (e.g. garnet, sirius) or a
# simulated one (e.g. garnet:mock).
IQM_QUANTUM_COMPUTER=garnet:mock
